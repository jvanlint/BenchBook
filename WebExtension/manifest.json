{
  "manifest_version": 3,
  "name": "BenchBook",
  "description": "Save pages, images, PDFs and highlighted text to a BenchBook project.",
  "version": "1.0",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "background": {
    "scripts": ["capture.js", "background.js"],
    "persistent": false
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to BenchBook",
    "default_icon": {
      "16": "toolbar-16.png",
      "19": "toolbar-19.png",
      "32": "toolbar-32.png",
      "38": "toolbar-38.png"
    }
  },
  "permissions": ["contextMenus", "nativeMessaging", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"]
}
